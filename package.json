{
  "name": "taskweaver-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "任务感知动态模型路由的多智能体编程桌面端",
  "main": "electron/main.cjs",
  "author": "TaskWeaver",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "NODE_OPTIONS='--max-old-space-size=8192' vite --host 127.0.0.1",
    "sync:dsh-sandbox": "node scripts/sync-dsh-sandbox.mjs",
    "sync:dsh-windows-acl": "node scripts/sync-dsh-windows-acl.mjs",
    "predev:electron": "node scripts/sync-dsh-sandbox.mjs",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "electron": "TASKWEAVER_PACKAGED=1 electron .",
    "build": "node scripts/verify-index-html.mjs && tsc -b && vite build && node scripts/strip-html-crossorigin.mjs",
    "start": "npm run build && TASKWEAVER_PACKAGED=1 electron .",
    "app": "node scripts/sync-dsh-sandbox.mjs && bash scripts/make-mac-app.sh",
    "dsh:runtime": "node scripts/build-z-runtime.mjs",
    "build:dsh-runtime": "node scripts/build-z-runtime.mjs",
    "extract:z-runtime": "node scripts/extract-and-rename-z-runtime.mjs",
    "build:z-runtime": "node scripts/build-z-runtime.mjs",
    "build:dsh-chat-registry": "node scripts/build-dsh-chat-registry.mjs",
    "test:z-runtime-build-atomic": "node scripts/test-z-runtime-build-atomic.mjs",
    "test:z-host-deploy": "node scripts/test-native-chat-command.mjs && node scripts/test-z-host-deploy.mjs && node scripts/test-z-queue-lifecycle.mjs && node scripts/test-z-failed-turn-lifecycle.mjs && node scripts/test-z-command-lifecycle.mjs",
    "test:z-recovery": "node scripts/test-z-recovery-history.mjs && node scripts/test-z-mux-recovery.mjs",
    "test:z-runtime-resolution": "node scripts/test-z-runtime-resolution.mjs && node scripts/test-prepare-runtime-cwd.mjs",
    "test:dsh-host-deploy": "npm run test:z-host-deploy",
    "test:dsh-runtime-resolution": "npm run test:z-runtime-resolution",
    "test:dsh-apiproxy": "cd vendor/z-runtime && ./node_modules/.bin/vitest run packages/host/apiproxy/tests/api-proxy-models.spec.ts",
    "app:builder": "npm run build && ELECTRON_BUILDER_REQUEST_TIMEOUT=1800000 electron-builder --mac --dir",
    "app:dmg": "npm run build && ELECTRON_BUILDER_REQUEST_TIMEOUT=1800000 electron-builder --mac dmg",
    "install:app": "npm run app && node scripts/install-mac-app.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:models": "node scripts/test-model-service.mjs && node scripts/test-model-override-registration.mjs",
    "test:model-registry": "node scripts/test-model-registry-updater.mjs && node scripts/validate-model-registry.mjs && node scripts/test-model-registry-mapping.mjs",
    "test:backend": "node scripts/test-backend-persistence.mjs",
    "test:single-writer": "node scripts/test-conversation-single-writer.mjs",
    "test:workspace-context": "node scripts/test-workspace-context.mjs",
    "test:prompt-pipeline": "node scripts/test-prompt-pipeline.mjs",
    "test:parity-bench": "node scripts/test-run-parity-bench.mjs",
    "test:workspace-trust": "node scripts/test-workspace-trust.mjs",
    "test:orchestration": "node scripts/test-orchestration.mjs",
    "test:skills": "node scripts/test-skill-service.mjs",
    "test:permissions": "node scripts/test-permissions.mjs && node scripts/test-permission-prompt-bridge.mjs",
    "test:credentials": "node scripts/test-credential-store.mjs",
    "test:tool-trace": "node scripts/test-tool-trace.mjs",
    "test:memory": "node scripts/test-memory-store.mjs",
    "test:pricing": "node scripts/test-price-registry.mjs && node scripts/pricing/test-deepseek-adapter.mjs",
    "test:mcp": "node scripts/test-mcp-service.mjs",
    "test:github-mcp-oauth": "node scripts/test-github-mcp-oauth.mjs",
    "test:verification": "node scripts/test-verification-policy.mjs",
    "test:usage": "node scripts/test-json-store-concurrency.mjs && node scripts/test-chat-turn-persistence.mjs && node scripts/test-usage-and-thinking.mjs && node scripts/test-session-usage.mjs && node scripts/test-session-stats.mjs",
    "test:session-stats": "node scripts/test-session-stats.mjs",
    "test:stream-segments": "node scripts/test-stream-segments.mjs",
    "test:stream-buffer": "node scripts/test-stream-buffer.mjs && node scripts/test-conversation-run-lifecycle.mjs",
    "test:opencodex-overlay": "node scripts/test-opencodex-reasoning-overlay.mjs",
    "test:security-path": "node scripts/test-security-path.mjs",
    "test:permission-rules": "node scripts/test-permission-rules.mjs",
    "test:git-checkpoints": "node scripts/test-git-checkpoints.mjs",
    "test:sandbox": "node scripts/test-sandbox-service.mjs",
    "test:custom-provider": "node scripts/test-custom-provider.mjs",
    "test:session-transcript": "node scripts/test-session-transcript-search.mjs",
    "test:fs-sandbox": "node scripts/test-fs-sandbox-fence.mjs",
    "test:sandbox-policy": "node scripts/test-sandbox-policy.mjs",
    "test:sandbox-escalation": "node scripts/test-sandbox-escalation.mjs",
    "test:mcp-marketplace": "node scripts/test-mcp-marketplace.mjs",
    "test:task-profile": "node scripts/test-task-profile.mjs",
    "test:dag-scheduler": "node scripts/test-dag-scheduler.mjs",
    "test:dag-live-evidence": "node scripts/run-agent-dag-live-smoke.mjs --self-test-evidence",
    "test:worktree-diff": "node scripts/test-worktree-diff.mjs",
    "test:coalesce": "node scripts/test-coalesce-content-blocks.mjs",
    "test:assistant-text-presentation": "node scripts/test-assistant-text-presentation.mjs",
    "test:appearance": "node scripts/test-appearance-theme.mjs",
    "test:terminal": "node scripts/test-terminal-service.mjs",
    "test:env": "node scripts/test-env-service.mjs",
    "test:threads": "node scripts/test-threads-archive-search.mjs",
    "test:portfolio": "node scripts/test-routing-portfolio.mjs && node scripts/test-quota-cycle.mjs",
    "test:chat-route": "node scripts/test-chat-model-resolver.mjs",
    "test:session-model-matches": "node scripts/test-session-model-matches.mjs",
    "test:dsh-chat": "node scripts/test-session-model-matches.mjs && node scripts/test-dsh-conversation-runtime.mjs && node scripts/test-dsh-chat-service.mjs && node scripts/test-projection-stream.mjs && node scripts/test-assistant-text-presentation.mjs",
    "test:lifecycle-smoke-diagnostics": "node scripts/test-lifecycle-smoke-diagnostics.mjs",
    "test:host-plan-todo-projection": "node scripts/test-host-plan-todo-projection.mjs",
    "test:dsh-permission-map": "node scripts/test-dsh-permission-map.mjs",
    "test:z-host": "node scripts/test-z-host.mjs",
    "test:dsh-host": "npm run test:z-host",
    "test:web-search": "node scripts/test-web-search-service.mjs",
    "test:integration": "node --test tests/*.test.mjs",
    "test:integration:multi-session": "node --test tests/multi-session-parallel.test.mjs",
    "test:integration:reconnect": "node --test tests/dsh-reconnect.test.mjs",
    "test:integration:permissions": "node --test tests/permission-flow.test.mjs",
    "test:all": "npm run test:z-host && npm run test:model-registry && npm run test:opencodex-health && npm run test:opencodex-setup-card && npm run test:z-host-deploy && npm run test:z-recovery && npm run test:z-runtime-resolution && npm run test:dsh-apiproxy && npm run test:dsh-chat && npm run test:dsh-tool-call-tree && npm run test:host-plan-todo-projection && npm run test:stream-buffer && npm run test:dsh-lifecycle && npm run test:dsh-permission-map && npm run test:security-path && npm run test:permission-rules && npm run test:git-checkpoints && npm run test:sandbox && npm run test:sandbox-policy && npm run test:fs-sandbox && npm run test:sandbox-escalation && npm run test:custom-provider && npm run test:session-transcript && npm run test:mcp-marketplace && npm run test:web-search && npm run test:coalesce && npm run test:appearance && npm run test:terminal && npm run test:env && npm run test:threads && npm run test:task-profile && npm run test:dag-scheduler && npm run test:dag-live-evidence && npm run test:worktree-diff && npm run test:portfolio && npm run test:chat-route && npm run test:models && npm run test:backend && npm run test:single-writer && npm run test:workspace-context && npm run test:context-compactor && npm run test:repo-map-service && npm run test:symbol-outline-extractor && npm run test:cursor-tool-guidance && npm run test:app-preferences && npm run test:prompt-pipeline && npm run test:workspace-trust && npm run test:orchestration && npm run test:skills && npm run test:permissions && npm run test:credentials && npm run test:tool-trace && npm run test:memory && npm run test:pricing && npm run test:mcp && npm run test:verification && npm run test:user-intent && npm run test:usage && npm run test:opencodex-overlay && npm run test:integration",
    "model-registry:generate": "node scripts/generate-model-registry.mjs",
    "model-registry:validate": "node scripts/validate-model-registry.mjs",
    "pricing:sync": "node scripts/pricing/sync-all.mjs",
    "pricing:sync:dry": "node scripts/pricing/sync-all.mjs --dry-run",
    "test:dsh-lifecycle": "node scripts/test-dsh-session-lifecycle.mjs",
    "test:user-intent": "node scripts/test-user-intent.mjs",
    "test:dsh-tool-call-tree": "node scripts/test-dsh-tool-call-tree.mjs",
    "test:opencodex-health": "node scripts/test-opencodex-health.mjs",
    "test:opencodex-setup-card": "node scripts/test-opencodex-setup-card.mjs",
    "test:context-compactor": "node scripts/test-context-compactor.mjs",
    "test:repo-map-service": "node scripts/test-repo-map-service.mjs",
    "test:symbol-outline-extractor": "node scripts/test-symbol-outline-extractor.mjs",
    "test:cursor-tool-guidance": "node scripts/test-cursor-tool-guidance.mjs",
    "test:app-preferences": "node scripts/test-app-preferences.mjs"
  },
  "optionalDependencies": {
    "@bitkyc08/opencodex": "^2.79.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.544.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
