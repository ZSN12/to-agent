{
  "name": "@z/dsh-web-app",
  "description": "TaskWeaver API-only host bundle: webserver + /api over dsh-base (no DSH browser UI roster)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/web-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@z/dsh-agent-presets": "workspace:^",
    "@z/dsh-api-remotes": "workspace:^",
    "@z/dsh-app-boot": "workspace:^",
    "@z/dsh-authorization": "workspace:^",
    "@z/dsh-client-connection": "workspace:^",
    "@z/dsh-client-runtime": "workspace:^",
    "@z/dsh-cmdline": "workspace:^",
    "@z/dsh-code-runtime-worker-thread": "workspace:^",
    "@z/dsh-cordis-host-runner": "workspace:^",
    "@z/dsh-host-apiproxy": "workspace:^",
    "@z/dsh-host-directory-picker-auto": "workspace:^",
    "@z/dsh-host-directory-picker-browse": "workspace:^",
    "@z/dsh-host-directory-picker-native": "workspace:^",
    "@z/dsh-host-plugin-inventory": "workspace:^",
    "@z/dsh-host-webserver": "workspace:^",
    "@z/dsh-file-reference": "workspace:^",
    "@z/dsh-file-reference-local": "workspace:^",
    "@z/dsh-launch-environment": "workspace:^",
    "@z/dsh-message-feedback": "workspace:^",
    "@z/dsh-session-projection-cache": "workspace:^",
    "@z/dsh-session-reference": "workspace:^",
    "@z/dsh-session-log-export": "workspace:^",
    "@z/dsh-session-stats": "workspace:^",
    "@z/dsh-storage": "workspace:^",
    "@z/dsh-storage-domain": "workspace:^",
    "@z/dsh-storage-json": "workspace:^",
    "@z/dsh-subprocess": "workspace:^",
    "@z/dsh-workspace": "workspace:^",
    "@z/schemastery": "workspace:^",
    "commander": "^15.0.0",
    "open": "^11.0.0"
  },
  "peerDependencies": {
    "@z/cordis-plugin-loader": "workspace:^",
    "@z/dsh-shell-env": "workspace:^",
    "@z/dsh-invariants": "workspace:^",
    "@z/dsh-system-prompt": "workspace:^",
    "@z/cordis": "workspace:^"
  },
  "devDependencies": {
    "@z/cordis-plugin-loader": "workspace:^",
    "@z/dsh-shell-env": "workspace:^",
    "@z/dsh-invariants": "workspace:^",
    "@z/dsh-system-prompt": "workspace:^",
    "@z/cordis": "workspace:^"
  }
}
