{
  "name": "@taskweaver/dsh-llm-taskweaver-bridge",
  "description": "TaskWeaver in-process model bridge LLM adapter (Cursor, Antigravity, custom relays)",
  "version": "0.1.0-taskweaver",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@taskweaver/cordis": "workspace:^",
    "@taskweaver/dsh-bridge-core": "workspace:^",
    "@taskweaver/dsh-home-paths": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-settings": "workspace:^",
    "@taskweaver/schemastery": "workspace:^"
  },
  "dependencies": {
    "@taskweaver/dsh-bridge-core": "workspace:^",
    "@taskweaver/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@taskweaver/cordis": "workspace:^",
    "@taskweaver/dsh-bridge-core": "workspace:^",
    "@taskweaver/dsh-home-paths": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-settings": "workspace:^"
  }
}
