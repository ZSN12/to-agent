{
  "name": "@taskweaver/ui-verify",
  "description": "Isolated Playwright driver for TaskWeaver Electron UI self-verification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./policy": {
      "types": "./lib/types/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "playwright-core": "1.64.0"
  },
  "peerDependencies": {
    "@z/cordis": "workspace:^",
    "@z/dsh-agent": "workspace:^",
    "@z/dsh-session": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@z/cordis": "workspace:^",
    "@z/dsh-agent": "workspace:^",
    "@z/dsh-session": "workspace:^",
    "playwright-core": "1.64.0",
    "vitest": "^4.1.8"
  }
}
