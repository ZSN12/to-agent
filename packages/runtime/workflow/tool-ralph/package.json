    "@z/dsh-system-prompt": "workspace:^",
    "@z/dsh-tools": "workspace:^",
    "@z/dsh-workflow": "workspace:^",
    "@z/cordis": "workspace:^"
  },
  "dependencies": {
    "@z/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@z/cordis-plugin-loader": "workspace:^",
    "@z/dsh-agent": "workspace:^",
    "@z/dsh-agent-loop": "workspace:^",
    "@z/dsh-agent-loop-testkit": "workspace:^",
    "@z/dsh-invariants": "workspace:^",
    "@z/dsh-llm": "workspace:^",
    "@z/dsh-session": "workspace:^",
    "@z/dsh-subagent": "workspace:^",
    "@z/dsh-subagent-in-process-driver": "workspace:^",
    "@z/dsh-subagent-spawn-in-process": "workspace:^",
    "@z/dsh-system-prompt": "workspace:^",
    "@z/dsh-tools": "workspace:^",
    "@z/dsh-workflow": "workspace:^",
    "@z/dsh-workflow-worker-thread": "workspace:^",
    "@z/cordis": "workspace:^"
  }
