{
  "name": "@taskweaver/dsh-client-runtime",
  "description": "Client session and workspace services with a shared Host connection stream",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/runtime/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@taskweaver/dsh-client-connection",
        "@taskweaver/dsh-typert-registry",
        "@taskweaver/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@taskweaver/cordis": "workspace:^",
    "@taskweaver/dsh-api-remotes": "workspace:^",
    "@taskweaver/dsh-typert-protocol": "workspace:^",
    "@taskweaver/dsh-typert-registry": "workspace:^",
    "@taskweaver/dsh-agent": "workspace:^",
    "@taskweaver/dsh-attachment": "workspace:^",
    "@taskweaver/dsh-client-connection": "workspace:^",
    "@taskweaver/dsh-commands": "workspace:^",
    "@taskweaver/dsh-host-apiproxy": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-llm-retry": "workspace:^",
    "@taskweaver/dsh-session": "workspace:^",
    "@taskweaver/dsh-session-projection": "workspace:^",
    "@taskweaver/dsh-session-title": "workspace:^",
    "@taskweaver/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@taskweaver/cordis": "workspace:^",
    "@taskweaver/dsh-api-remotes": "workspace:^",
    "@taskweaver/dsh-timeout": "workspace:^",
    "@taskweaver/dsh-typert-protocol": "workspace:^",
    "@taskweaver/dsh-typert-registry": "workspace:^",
    "@taskweaver/dsh-agent": "workspace:^",
    "@taskweaver/dsh-attachment": "workspace:^",
    "@taskweaver/dsh-client-connection": "workspace:^",
    "@taskweaver/dsh-commands": "workspace:^",
    "@taskweaver/dsh-host-apiproxy": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-llm-retry": "workspace:^",
    "@taskweaver/dsh-session": "workspace:^",
    "@taskweaver/dsh-session-projection": "workspace:^",
    "@taskweaver/dsh-session-title": "workspace:^",
    "@taskweaver/dsh-tools": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
