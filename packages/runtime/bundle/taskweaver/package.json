{
  "name": "@taskweaver/dsh-taskweaver",
  "description": "TaskWeaver API-only Host startup, explicit /api trust authorities, and readiness signal",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/runtime/bundle/taskweaver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taskweaver/dsh-agent-presets": "workspace:^",
    "@taskweaver/dsh-api-remotes": "workspace:^",
    "@taskweaver/dsh-authorization": "workspace:^",
    "@taskweaver/dsh-client-connection": "workspace:^",
    "@taskweaver/dsh-cmdline": "workspace:^",
    "@taskweaver/dsh-code-runtime-python": "workspace:^",
    "@taskweaver/dsh-code-runtime-worker-thread": "workspace:^",
    "@taskweaver/dsh-cordis-host-runner": "workspace:^",
    "@taskweaver/dsh-host-apiproxy": "workspace:^",
    "@taskweaver/dsh-host-directory-picker-native": "workspace:^",
    "@taskweaver/dsh-host-plugin-inventory": "workspace:^",
    "@taskweaver/dsh-host-webserver": "workspace:^",
    "@taskweaver/dsh-lsp": "workspace:^",
    "@taskweaver/dsh-lsp-stdio": "workspace:^",
    "@taskweaver/dsh-file-reference": "workspace:^",
    "@taskweaver/dsh-file-reference-local": "workspace:^",
    "@taskweaver/dsh-session-projection-cache": "workspace:^",
    "@taskweaver/dsh-session-reference": "workspace:^",
    "@taskweaver/dsh-session-log-export": "workspace:^",
    "@taskweaver/dsh-session-stats": "workspace:^",
    "@taskweaver/dsh-storage": "workspace:^",
    "@taskweaver/dsh-storage-domain": "workspace:^",
    "@taskweaver/dsh-storage-json": "workspace:^",
    "@taskweaver/dsh-tool-lsp": "workspace:^",
    "@taskweaver/dsh-tool-web": "workspace:^",
    "@taskweaver/tool-ui-verify": "workspace:^",
    "@taskweaver/dsh-web": "workspace:^",
    "@taskweaver/dsh-web-search-taskweaver": "workspace:^",
    "@taskweaver/dsh-workspace": "workspace:^",
    "@taskweaver/schemastery": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@taskweaver/cordis-plugin-loader": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taskweaver/cordis-plugin-loader": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/cordis": "workspace:^"
  },
  "taskweaver": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
