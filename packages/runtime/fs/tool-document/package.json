{
  "name": "@taskweaver/dsh-tool-document",
  "description": "Bounded, sandboxed document reading tool for PDF and Office Open XML, with approval-gated legacy Office conversion",
  "version": "0.1.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taskweaver/dsh-home-paths": "workspace:^",
    "@taskweaver/dsh-tool-fs": "workspace:^",
    "@taskweaver/schemastery": "workspace:^",
    "@napi-rs/canvas": "0.1.100",
    "fflate": "^0.8.3",
    "pdfjs-dist": "4.10.38"
  },
  "peerDependencies": {
    "@taskweaver/dsh-attachment": "workspace:^",
    "@taskweaver/dsh-fs": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-system-prompt": "workspace:^",
    "@taskweaver/dsh-spill": "workspace:^",
    "@taskweaver/dsh-tools": "workspace:^",
    "@taskweaver/dsh-user-approval": "workspace:^",
    "@taskweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taskweaver/dsh-agent-loop-testkit": "workspace:^",
    "@taskweaver/dsh-attachment": "workspace:^",
    "@taskweaver/dsh-fs-local": "workspace:^",
    "@taskweaver/dsh-home-paths": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-system-prompt": "workspace:^",
    "@taskweaver/dsh-spill": "workspace:^",
    "@taskweaver/dsh-tools": "workspace:^",
    "@taskweaver/dsh-user-approval": "workspace:^",
    "@taskweaver/cordis": "workspace:^",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "fixtures:documents": "tsx tests/generate-fixtures.ts"
  }
}
