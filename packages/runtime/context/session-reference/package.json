{
  "name": "@taskweaver/dsh-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/runtime/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taskweaver/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@taskweaver/dsh-agent": "workspace:^",
    "@taskweaver/dsh-compaction": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-output-retention": "workspace:^",
    "@taskweaver/dsh-session": "workspace:^",
    "@taskweaver/dsh-session-query": "workspace:^",
    "@taskweaver/dsh-typert-protocol": "workspace:^",
    "@taskweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taskweaver/dsh-agent": "workspace:^",
    "@taskweaver/dsh-compaction": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/dsh-llm": "workspace:^",
    "@taskweaver/dsh-output-retention": "workspace:^",
    "@taskweaver/dsh-session": "workspace:^",
    "@taskweaver/dsh-session-query": "workspace:^",
    "@taskweaver/dsh-typert-protocol": "workspace:^",
    "@taskweaver/cordis": "workspace:^"
  }
}
