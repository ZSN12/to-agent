{
  "name": "@taskweaver/dsh-file-reference-local",
  "description": "Local-filesystem ctx.fileReferences provider with bounded fuzzy indexes",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/runtime/context/file-reference-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/types/search.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taskweaver/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@taskweaver/dsh-agent": "workspace:^",
    "@taskweaver/dsh-file-reference": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/dsh-system-prompt": "workspace:^",
    "@taskweaver/dsh-tools": "workspace:^",
    "@taskweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taskweaver/dsh-agent": "workspace:^",
    "@taskweaver/dsh-file-reference": "workspace:^",
    "@taskweaver/dsh-invariants": "workspace:^",
    "@taskweaver/dsh-system-prompt": "workspace:^",
    "@taskweaver/dsh-tools": "workspace:^",
    "@taskweaver/cordis": "workspace:^"
  }
}
