{
  "name": "@taskweaver/runtime-workspace",
  "version": "0.1.1-rc.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:host": "tsc -b tsconfig.host.taskweaver.json && tsdown --env.TASKWEAVER_BUILD_FACE host --filter @taskweaver/dsh --filter @taskweaver/dsh-agent-loop --filter @taskweaver/ui-verify --filter @taskweaver/tool-ui-verify",
    "build:lib": "pnpm run build:lib:host && pnpm run build:lib:client",
    "build:lib:host": "tsc -b tsconfig.host.taskweaver.json && tsdown --env.TASKWEAVER_BUILD_FACE host",
    "build:lib:client": "tsc -b tsconfig.client.taskweaver.json && tsdown --env.TASKWEAVER_BUILD_FACE client",
    "build:client:min": "tsc -b tsconfig.client.taskweaver-min.json",
    "build:web": "pnpm --filter @taskweaver/dsh-web-frontend run build",
    "typecheck": "pnpm run build:lib:host && tsc -b tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:web": "pnpm run build && pnpm run test:web:built",
    "test:web:built": "vitest run --config vitest.web.config.ts",
    "test:gui": "vitest run client host",
    "taskweaver-host": "node --import tsx/esm host-cli/src/bin.ts",
    "dsh": "node --import tsx/esm host-cli/src/bin.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@yarnpkg/cli-dist": "4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "execa": "^10.0.0",
    "fast-check": "^4.8.0",
    "js-yaml": "^4.2.0",
    "jscpd": "^5.0.12",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "^0.3.21",
    "smol-toml": "^1.7.1",
    "spdx-expression-parse": "^5.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
